# ==========================================
# SOAP vs REST Enterprise Demo - .gitignore
# ==========================================

# ------------------------------------------
# Frontend (Angular 19 & Node.js)
# ------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/.angular/cache/
node_modules/
dist/
.angular/

# npm / yarn / pnpm debug logs & cache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*
*.tgz

# ------------------------------------------
# Backend (Java 17, Spring Boot & Maven)
# ------------------------------------------
backend/target/
target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Maven wrapper jar (if generated)
!**/src/main/**/target/
!**/src/test/**/target/

# ------------------------------------------
# IDEs & Code Editors
# ------------------------------------------
# IntelliJ IDEA
.idea/
backend/.idea/
*.iml
*.iws
*.ipr
out/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# NetBeans
/nbproject/private/
/build/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# Sublime Text
*.sublime-workspace
*.sublime-project

# ------------------------------------------
# Environment & Sensitive Files
# ------------------------------------------
.env
.env.local
.env.*.local
*.env
application-local.properties
application-local.yml

# ------------------------------------------
# Operating System Files
# ------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------
# Database / Backups / Dumps
# ------------------------------------------
*.bak
*.dump
*.sql.gz
